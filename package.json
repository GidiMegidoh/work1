{
  "name": "shibutz",
  "version": "1.0.0",
  "description": "שיבוץ — סוכן WhatsApp בעברית לקביעת תורים, מרובה-טננטים, עם אולפן דמו ללקוחות פוטנציאליים",
  "main": "src/core/agent.js",
  "type": "commonjs",
  "scripts": {
    "sim": "node src/cli/sim.js",
    "demo:new": "node src/cli/demo-new.js",
    "demo": "node src/cli/demo-serve.js",
