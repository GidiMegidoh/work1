# קונפיגורציית שליחת הדמו (outreach/) — העתיקו ל-.env ומלאו ערכים.
# ‏.env נמצא ב-.gitignore ולא נדחף לריפו.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# מספר השולח. ברירת מחדל אם ריק: ה-sandbox של Twilio (whatsapp:+14155238886).
# במעבר למספר עסקי מאושר — שימו כאן את המספר שלכם.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# קישור הדמו שמצורף לכל הודעה. אם ריק — נלקח הקישור הראשון מ-assets/wa-link.md.
DEMO_LINK=

# DRY_RUN=1 — הדפסה ורישום ביומן בלי שליחה אמיתית
