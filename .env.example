# ============================================================================
#  שרת שיבוץ החי — משתני סביבה. העתיקו ל-.env ומלאו. .env לעולם לא בקומיט.
# ============================================================================

# ---- שרת ----
PORT=8080
# סוד יחיד לממשק הניהול (/admin/*): בחרו מחרוזת אקראית ארוכה.
# openssl rand -hex 24
ADMIN_SECRET=

# ---- WhatsApp Cloud API ----
# אפשר לקבוע כבר עכשיו (לא תלוי באישור Meta): מחרוזת שאתם ממציאים,
# ומדביקים גם בהגדרת ה-webhook בלוח של Meta.
WHATSAPP_VERIFY_TOKEN=

# App Secret של האפליקציה: developers.facebook.com → האפליקציה →
# App Settings → Basic → App Secret. בלעדיו כל POST ל-webhook נדחה (403).
WHATSAPP_APP_SECRET=

# מגיעים רק אחרי אישור Meta. כל עוד WHATSAPP_TOKEN ריק — השרת במצב DRY-RUN:
# שום הודעה לא נשלחת, ה-payload נרשם ללוג.
# טוקן קבוע של System User: business.facebook.com → Business Settings →
# System Users → Generate Token (הרשאות whatsapp_business_messaging).
WHATSAPP_TOKEN=
# מזהה המספר: WhatsApp Manager → Phone numbers → Phone number ID.
# את אותו ערך מדביקים גם ב-tenants/<slug>.json → whatsapp.phoneNumberId.
WHATSAPP_PHONE_NUMBER_ID=
# גרסת Graph API (אופציונלי, ברירת מחדל v21.0)
GRAPH_API_VERSION=

# ---- Google Calendar (service account) ----
# אחת משתי הדרכים:
# 1) תוכן קובץ ה-JSON של חשבון השירות, בשורה אחת:
GOOGLE_SERVICE_ACCOUNT_JSON=
# 2) או נתיב לקובץ (נוח עם volume בדוקר):
GOOGLE_SERVICE_ACCOUNT_FILE=
