# ============================================================
#  העתיקו את הקובץ הזה ל-.env ומלאו את הערכים
#  cp .env.example .env
# ============================================================

# --- Twilio ---
# מתוך ה-Console: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# מספר ה-WhatsApp של Twilio.
# ב-Sandbox המספר תמיד +14155238886 (אל תשכחו את הקידומת whatsapp:)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- שרת ---
PORT=3000

# --- הגדרות דמו ---
# שם המרפאה שמופיע בהודעות
CLINIC_NAME=מרפאת ד"ר כהן

# כמה זמן עד שנשלחת התזכורת (מילישניות).
# 60000 = דקה אחת — סימולציה של "תזכורת יום לפני"
REMINDER_DELAY_MS=60000

# --- אבטחה (אופציונלי) ---
# הפעלת אימות חתימת Twilio על הוובהוק.
# בדמו מקומי השאירו false; בפרודקשן הפעילו true.
VALIDATE_TWILIO_SIGNATURE=false

# הכתובת הציבורית של השרת (ngrok / Railway / Render).
# נדרש רק כאשר VALIDATE_TWILIO_SIGNATURE=true
PUBLIC_URL=https://your-subdomain.ngrok-free.app
