# קונפיגורציית outreach — העתיקו ל-.env ומלאו (הקובץ .env לא נכנס ל-git)

# חשבון Twilio: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# מספר השולח ב-WhatsApp. ברירת מחדל: מספר ה-Sandbox של Twilio.
# ב-Sandbox הפרוספקט חייב קודם לשלוח "join <קוד>" למספר הזה פעם אחת.
TWILIO_WHATSAPP_FROM=+14155238886

# הקישור שנשלח לפרוספקט — כתובת הדמו המאורח. שתי דרכים לארח:
#   1. npm run demo:standalone veltrum → קובץ אחד (standalone.html) שמכיל
#      את האתר + הבוט, להעלאה לכל אירוח סטטי (Netlify Drop, GitHub Pages...)
#   2. אירוח התיקייה demo/sites/veltrum/ כמו שהיא
# בלי זה יישלח קישור localhost חסר-תועלת.
DEMO_URL=

# (אופציונלי) קישור ישיר לנגן הצ'אט — מוסיף שורה שנייה להודעה.
# רלוונטי כשמארחים את התיקייה המלאה: DEMO_CHAT_URL=<DEMO_URL>/chat.html
DEMO_CHAT_URL=

# DRY_RUN=1 — בדיקת התבנית והיומן בלי שליחה אמיתית
# DRY_RUN=1
